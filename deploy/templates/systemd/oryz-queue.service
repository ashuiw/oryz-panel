[Unit]
Description=Oryz Panel queue workers
PartOf=oryz.target
After=redis-server.service

[Service]
Type=simple
User=@@USER@@
Group=@@GROUP@@
WorkingDirectory=@@APP_DIR@@
EnvironmentFile=@@ENV_FILE@@
Environment=NODE_ENV=production
Environment=ORYZ_ROLE=queue
ExecStart=/usr/bin/node @@APP_DIR@@/.output/server/queue.mjs
Restart=always
RestartSec=10
# Drain in-flight jobs before exiting.
KillSignal=SIGTERM
TimeoutStopSec=120

StandardOutput=append:@@LOG_DIR@@/queue.log
StandardError=append:@@LOG_DIR@@/queue.error.log
SyslogIdentifier=oryz-queue

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@@STATE_DIR@@ @@LOG_DIR@@
CapabilityBoundingSet=

[Install]
WantedBy=oryz.target

# Oryz Panel — environment reference.
#
# The installer generates the real file at /etc/oryz/oryz.env with secure
# random secrets. This template documents every key so you can audit or
# hand-write a configuration. Never commit a populated copy.

# --- application -------------------------------------------------------------
NODE_ENV=production
APP_NAME=Oryz Panel
APP_URL=https://panel.example.com     # public base URL, no trailing slash
APP_DOMAIN=panel.example.com
APP_HOST=127.0.0.1                    # bind address; keep on loopback behind a proxy
APP_PORT=3000
HOST=127.0.0.1                        # consumed by the Node server entry
PORT=3000                             # must match APP_PORT
APP_KEY=                              # 32-byte random, application-wide key
TRUST_PROXY=true                      # honour X-Forwarded-* from the reverse proxy
LOG_LEVEL=info                        # error | warn | info | debug

# --- websocket ---------------------------------------------------------------
WS_HOST=127.0.0.1
WS_PORT=3001
WS_PUBLIC_URL=wss://panel.example.com/ws
WS_HEARTBEAT_INTERVAL_MS=25000
WS_MAX_PAYLOAD_BYTES=1048576

# --- database ----------------------------------------------------------------
DATABASE_URL=postgresql://oryz:PASSWORD@127.0.0.1:5432/oryz?sslmode=prefer
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=oryz
DB_USER=oryz
DB_PASSWORD=
DB_SSLMODE=prefer
DB_POOL_MAX=20

# --- redis, queues -----------------------------------------------------------
REDIS_URL=redis://:PASSWORD@127.0.0.1:6379/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
QUEUE_CONCURRENCY=5

# --- secrets (generate with: openssl rand -base64 48) ------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
SESSION_SECRET=
ENCRYPTION_KEY=                       # 64 hex chars; rotating it invalidates stored ciphertext
API_SIGNING_SECRET=
DAEMON_SIGNING_KEY=                   # signs panel → daemon JWTs
WEBHOOK_SIGNING_SECRET=

# --- storage -----------------------------------------------------------------
STORAGE_DRIVER=local                  # local | s3
STORAGE_PATH=/var/lib/oryz/storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- mail --------------------------------------------------------------------
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Oryz Panel

# --- tls / proxy -------------------------------------------------------------
PROXY_KIND=nginx
SSL_MODE=letsencrypt
SSL_EMAIL=
SSL_CERT_PATH=
SSL_KEY_PATH=

# --- paths -------------------------------------------------------------------
ORYZ_HOME=/opt/oryz
ORYZ_APP_DIR=/opt/oryz/app
ORYZ_STATE_DIR=/var/lib/oryz
ORYZ_BACKUP_DIR=/var/lib/oryz/backups
ORYZ_LOG_DIR=/var/log/oryz
ORYZ_USER=oryz
ORYZ_GROUP=oryz

# --- integrations (optional; blank disables the feature) ---------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SENTRY_DSN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
STEAM_API_KEY=
CURSEFORGE_API_KEY=

# --- local node (wings) ------------------------------------------------------
WINGS_INSTALLED=no                    # yes when this host also runs a node
WINGS_CONF_FILE=/etc/oryz-wings/config.yml
WINGS_NODE_UUID=

# --- authentication backend --------------------------------------------------
# Inlined into the browser bundle at build time; run `panelctl rebuild` after
# changing either value, otherwise the UI keeps the previously built values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-side only. Used by `panelctl admin:create` to provision accounts in the
# hosted backend. Never inlined into the browser bundle.
SUPABASE_SECRET_KEY=

# --- setup wizard ------------------------------------------------------------
SETUP_COMPLETE=false                  # true disables /setup permanently

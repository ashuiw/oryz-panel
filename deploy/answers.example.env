# Oryz Panel — unattended installation answers.
#
#   sudo install -m 0600 answers.example.env /root/oryz-answers.env
#   sudo nano /root/oryz-answers.env
#   sudo ./install.sh --non-interactive --config /root/oryz-answers.env
#
# Anything omitted falls back to the default shown in the comment. Values that
# have no safe default (domain, admin email) are required.
# This file may hold secrets: keep it at mode 0600 and delete it afterwards.

# --- what to install ---------------------------------------------------------
INSTALL_COMPONENTS=panel+wings      # panel+wings | panel | wings

# --- node (wings) ------------------------------------------------------------
# Used when INSTALL_COMPONENTS includes wings.
WINGS_NODE_NAME=node-01
WINGS_FQDN=node01.example.com       # public FQDN/IP players and the panel reach
WINGS_SCHEME=https                  # https | http
WINGS_PORT=8080
WINGS_SFTP_PORT=2022
WINGS_DATA_DIR=/var/lib/oryz-wings
WINGS_MEMORY_MB=8192                # memory this node offers to servers
WINGS_DISK_MB=51200
# WINGS_PANEL_URL=https://panel.example.com   # required for wings-only installs
# WINGS_NODE_TOKEN=                 # token issued by that panel; generated when omitted

# --- domain and networking ---------------------------------------------------
PANEL_DOMAIN=panel.example.com
APP_PORT=3000                       # internal HTTP port
WS_PORT=3001                        # internal WebSocket port
PROXY_KIND=nginx                    # nginx | caddy | traefik | none

# --- TLS ---------------------------------------------------------------------
SSL_MODE=letsencrypt                # letsencrypt | existing | selfsigned | none
SSL_EMAIL=admin@example.com         # required for letsencrypt
# SSL_CERT_PATH=/etc/ssl/certs/panel.pem     # required for SSL_MODE=existing
# SSL_KEY_PATH=/etc/ssl/private/panel.key

# --- database ----------------------------------------------------------------
DB_MODE=local                       # local | remote
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=oryz
DB_USER=oryz
# DB_PASSWORD=                      # generated automatically when DB_MODE=local
DB_SSLMODE=prefer                   # disable | prefer | require | verify-full

# --- redis -------------------------------------------------------------------
REDIS_MODE=local                    # local | remote
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=                   # generated automatically when REDIS_MODE=local

# --- storage -----------------------------------------------------------------
STORAGE_DRIVER=local                # local | s3
STORAGE_PATH=/var/lib/oryz/storage
# S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# S3_REGION=eu-central-1
# S3_BUCKET=oryz-backups
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- email -------------------------------------------------------------------
SMTP_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENCRYPTION=starttls            # starttls | tls | none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_FROM_NAME=Oryz Panel

# --- administrator -----------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
# ADMIN_PASSWORD=                   # generated when omitted; read it once with
                                    # `panelctl config get-admin-password`

# --- integrations (all optional; blank disables the feature) ------------------
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# DISCORD_WEBHOOK_URL=
# SLACK_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SENTRY_DSN=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# HCAPTCHA_SITE_KEY=
# HCAPTCHA_SECRET_KEY=
# STEAM_API_KEY=
# CURSEFORGE_API_KEY=

# --- optional components -----------------------------------------------------
INSTALL_DOCKER=no                   # yes when this host also runs game servers

# --- behaviour ---------------------------------------------------------------
ORYZ_ASSUME_YES=1                 # accept destructive confirmations
# ORYZ_FORCE_OS=1                 # allow unsupported distributions
# ORYZ_HOME=/opt/oryz
# ORYZ_ENV_FILE=/etc/oryz/oryz.env
